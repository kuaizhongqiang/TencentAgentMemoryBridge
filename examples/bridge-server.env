# Bridge Server configuration
PORT=3000

# TencentDB Agent Memory Gateway URL (internal network)
TENCENTDB_URL=http://localhost:8080

# Agent whitelist — option 1: JSON file path (recommended)
# File should contain a JSON array of agent objects.
AGENTS_FILE=./agents.json

# Agent whitelist — option 2: inline JSON (alternative to AGENTS_FILE)
# Each agent has: name, apiKeyHash (sha256 of the API key), allowedEndpoints
# AGENTS=[{"name":"codebuddy","apiKeyHash":"<sha256>","allowedEndpoints":["recall","capture","search/memories"]}]

# ── 监听地址（issue #43，bridge-server >= 0.3.0）────────────────────────────
# 默认 wan：与旧版完全一致（通配绑定）。可选：
#   LISTEN_MODE=wan|tailscale|both
#   LISTEN_HOSTS=100.64.1.23,192.168.1.10   # 显式多地址（同 PORT），不含 0.0.0.0
#   HOST=192.168.1.10                        # 单地址别名；与 LISTEN_HOSTS 同时给时后者优先
#   TAILSCALE_LISTEN=true                    # 等价 LISTEN_MODE=tailscale（只绑尾网 IP）
#   LISTEN_MODE=both                         # 显式 LISTEN_HOSTS/HOST + 尾网 IP（无显式 host 会报错）
#   TAILSCALE_IP=100.x.y.z                   # 可选：tailscale CLI / 网卡 tailscale0 都拿不到时的兜底
LISTEN_MODE=wan

# ── Tailscale 入口 + /v3 透明转发（可选）───────────────────────────────────
# 只绑尾网 IP 并把 mcp-bridge 的 /v3/* 请求转发到本机 MemoryCore：
#   LISTEN_MODE=tailscale
#   V3_UPSTREAM=http://127.0.0.1:8422
# V3_UPSTREAM=/v3/* 转发目标（MemoryCore Gateway）；不设则不开放 /v3 路由
# V3_PROXY_TIMEOUT_MS=30000
# AUTH_MODE=tailscale   # 仅 tailscale serve 场景：认 Tailscale-User-Login（默认 shared-key）
