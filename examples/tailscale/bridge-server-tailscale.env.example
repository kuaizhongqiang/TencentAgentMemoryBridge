# /home/kuai/.config/tencent-memory/bridge-server-tailscale.env
#
# bridge-server Tailscale 专用入口（mcp-bridge /v3 透明转发）。
# 目标：只监听本机 Tailscale IPv4，不向公网暴露；客户端用
#   MEMORY_ENDPOINTS=http://100.x.y.z:3000,https://memory.kuai-private.top
# 即可在公网抖动时走尾网直连。
#
# 变量语义见 docs/bridge-server-tailscale.md。

# 监听端口（所有地址共用）
PORT=3000

# 只绑 Tailscale IPv4（运行时自动解析：tailscale ip -4 -> 网卡 tailscale0 -> TAILSCALE_IP）
LISTEN_MODE=tailscale

# /v3/* 透明转发目标（本机 MemoryCore Gateway）
V3_UPSTREAM=http://127.0.0.1:8422
V3_PROXY_TIMEOUT_MS=30000

# legacy /api/v1/* 的共享 key 白名单；仅用 /v3 时留空数组即可
AGENTS=[]

# 可选：tailscale CLI 与网卡都拿不到 IP 时显式指定
# TAILSCALE_IP=100.x.y.z

# 可选：legacy 请求信任 tailscale serve 注入的 Tailscale-User-Login（默认关）
# AUTH_MODE=tailscale
